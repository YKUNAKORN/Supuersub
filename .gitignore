# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Owner's working notes: phase prompts and the sample files they reference.
# Kept locally, never published with the plugin.
dev-prompts/

# Local Claude Code state (per-machine settings, worktrees)
.claude/settings.local.json
.claude/worktrees/

# Scratch directories scripts/validate.py creates and removes; ignored in case a
# run is interrupted before cleanup.
.validate-tmp/
.validate-tmp-db/

# Plugin packages built for "Upload plugin" in claude.ai / Cowork. Root level only,
# so test fixtures that happen to be archives are not affected.
/*.zip
/*.plugin
/dist/
/build/

# Secrets and local environment
.env
.env.*
